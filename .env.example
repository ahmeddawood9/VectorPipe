# --- Required ---------------------------------------------------------------------------------
# PostgreSQL connection URL (plain postgresql:// is accepted and mapped to the psycopg 3 driver).
DATABASE_URL=postgresql://vectorpipe:vectorpipe@localhost:5432/vectorpipe

# --- Core settings ----------------------------------------------------------------------------
# Root directory for local object storage (raw/, processed/) and the local queue (queue/).
LOCAL_STORAGE_ROOT=./storage
# Simulated "expensive AI work" per document, in seconds.
PROCESSING_DELAY_SECONDS=3
LOG_LEVEL=INFO
# How often a waiting consumer re-checks the local queue while long-polling, in seconds.
QUEUE_POLL_INTERVAL_SECONDS=0.5

# --- Optional tuning (defaults shown) ---------------------------------------------------------
# A received message stays hidden (in flight) this long before it is redelivered.
QUEUE_VISIBILITY_TIMEOUT_SECONDS=60
# Deliveries before an unacknowledged message is dead-lettered (= max processing attempts).
QUEUE_MAX_RECEIVE_COUNT=3
# First retry delay; doubles on every further failed attempt.
RETRY_BACKOFF_SECONDS=2
MAX_UPLOAD_BYTES=10485760
API_HOST=127.0.0.1
API_PORT=8000
# Each worker exposes Prometheus metrics here (0 disables). Use a different port per worker.
WORKER_METRICS_PORT=9101
# Dev aid: probability (0-1) that a processing attempt fails, to exercise retries. Keep 0 normally.
SIMULATE_FAILURE_RATE=0

# --- Backends (default: local; no AWS needed) -----------------------------------------------------
# STORAGE_BACKEND=s3 and/or QUEUE_BACKEND=sqs switch to AWS. Credentials are never set here: boto3 uses the
# ambient identity (IAM role, SSO profile, AWS_PROFILE ...).
STORAGE_BACKEND=local
QUEUE_BACKEND=local
# Profile in ~/.aws/config that assumes the vectorpipe-dev role (see README). Leave unset to use boto3's default chain.
# AWS_PROFILE=vectorpipe-dev
# AWS_REGION=us-east-1   # must equal the Terraform `region` (see `terraform output region`)
# S3_BUCKET=
# SQS_QUEUE_URL=
# SQS_DLQ_URL=
# Must equal maxReceiveCount in the SQS queue's redrive policy (checked at startup).
